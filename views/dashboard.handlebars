
<h2>My Dashboard</h2>
<h3>My Pickup Location Photo</h3>

{{#if customer.photoFilename}}
    <img
        src="/customer-photo"
        alt="My pickup location"
        class="customer-photo"
    >
{{else}}
    <p>You have not uploaded a pickup location photo yet.</p>
{{/if}}

<form action="/upload-photo" method="POST" enctype="multipart/form-data">
    <label for="photo">Upload or replace your pickup location photo (JPG only):</label>
    <input
        type="file"
        id="photo"
        name="photo"
        accept=".jpg,image/jpeg"
        required
    >
    <button type="submit">Upload Photo</button>
</form>

<h3>My Orders</h3>

{{#if orders.length}}
    <table>
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Order Date</th>
                <th>Status</th>
                <th>Items</th>
            </tr>
        </thead>

        <tbody>
            {{#each orders}}
                <tr>
                    <td>{{this._id}}</td>
                    <td>{{this.orderDate}}</td>
                    <td>{{this.status}}</td>
                    <td>
                        {{#each this.items}}
                            <p>
                                Service ID: {{this.serviceId}}
                                - Quantity: {{this.quantity}}
                            </p>
                        {{/each}}
                    </td>
                </tr>
            {{/each}}
        </tbody>
    </table>
{{else}}
    <p>You do not have any orders yet.</p>
{{/if}}
