
<h2>My Dashboard</h2>

<h3>My Orders</h3>

{{#if orders.length}}
    <table>
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Order Date</th>
                <th>Status</th>
                <th>Items</th>
            </tr>
        </thead>

        <tbody>
            {{#each orders}}
                <tr>
                    <td>{{this._id}}</td>
                    <td>{{this.orderDate}}</td>
                    <td>{{this.status}}</td>
                    <td>
                        {{#each this.items}}
                            <p>
                                Service ID: {{this.serviceId}}
                                - Quantity: {{this.quantity}}
                            </p>
                        {{/each}}
                    </td>
                </tr>
            {{/each}}
        </tbody>
    </table>
{{else}}
    <p>You do not have any orders yet.</p>
{{/if}}
